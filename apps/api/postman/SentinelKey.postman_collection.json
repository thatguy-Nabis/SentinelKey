    {
      "name": "Phase 10a - Domain Registry",
      "item": [
        {
          "name": "Register Domain",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.domain) {",
                  "  pm.collectionVariables.set('domainId', res.data.domain._id || res.data.domain.id);",
                  "}",
                  "if (res.data && res.data.siteKey) {",
                  "  pm.collectionVariables.set('siteKey', res.data.siteKey);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
