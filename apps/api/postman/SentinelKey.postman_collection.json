          }
        },
        {
          "name": "List Compliance Policies",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/policies",
              "host": ["{{baseUrl}}"],
              "path": ["policies"]
