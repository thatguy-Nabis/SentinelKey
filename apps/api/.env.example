# SentinelKey API
PORT=4000
MONGODB_URI=mongodb://localhost:27017/sentinelkey

# Development convenience: with NO MONGODB_URI set, the API auto-starts an
# ephemeral in-memory MongoDB (mongodb-memory-server, dev dependency) so the
# stack runs with zero external services. Data is wiped on restart.
# Set USE_MEMORY_MONGO=false to force the default localhost URI above instead.
# USE_MEMORY_MONGO=true

# JWT secrets (CHANGE THESE in production — minimum 32 characters)
JWT_ACCESS_SECRET=dev-access-secret-change-me-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10

# MFA (Phase 2)
MFA_ENCRYPTION_KEY=dev-mfa-encryption-key-32chars!!
MFA_MAX_FAILED_ATTEMPTS=5
MFA_LOCKOUT_DURATION_MS=300000
MFA_TOKEN_EXPIRES_IN=5m

# Encryption (Phase 5) — CHANGE in production; required for file/field encryption.
# Use a 64-char hex string (32 bytes) or any passphrase (derived via HKDF).
ENCRYPTION_MASTER_KEY=dev-encryption-master-key-32ch!!

# Optional: multiple key versions as JSON map {"1":"<64hex>","2":"<64hex>"}
# ENCRYPTION_MASTER_KEYS=

# Optional: file path where runtime key rotations are persisted (survives restart).
# If unset, rotated keys live only in memory for the process lifetime.
# KEY_REGISTRY_PATH=data/key-registry.json

# Active key version (defaults to 1, or the persisted version after a rotation)
ACTIVE_KEY_VERSION=1

# File storage directory for encrypted file envelopes
FILE_STORAGE_DIR=data/encrypted-files

# ML anomaly detection (Phase 6)
ML_SERVICE_URL=http://localhost:5001
ML_ANOMALY_THRESHOLD=0.65
ML_ANOMALY_ENABLED=true

# Optional: bootstrap admin account created at startup (recommended so the first
# self-registering user is NOT automatically granted admin).
# BOOTSTRAP_ADMIN_EMAIL=admin@sentinelkey.local
# BOOTSTRAP_ADMIN_PASSWORD=change-me-to-a-strong-password

# Khalti Payment Gateway (docs/payment-integration.md)
# Leave KHALTI_SECRET_KEY unset/blank to use the built-in MockPaymentProvider in local dev.
# For sandbox testing:
# KHALTI_SECRET_KEY=test_secret_key_your_sandbox_key
# KHALTI_BASE_URL=https://dev.khalti.com/api/v2
# For live production:
# KHALTI_SECRET_KEY=live_secret_key_your_production_key
# KHALTI_BASE_URL=https://a.khalti.com/api/v2
KHALTI_SECRET_KEY=
KHALTI_BASE_URL=
WEBSITE_URL=http://localhost:5174

# NODE_ENV=development

